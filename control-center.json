  {
    "id": "tor",
    "slot": "tor",
    "providerId": "tripleu.tor",
    "title": "Tor",
    "glyph": "\uf2f0",
    "kind": "toggle",
    "backend": "command",
    "needsBin": "tormarchy",
    "read": [
      "bash",
      "-c",
      "tormarchy status --json 2>/dev/null | python3 -c 'import json, sys; s = json.load(sys.stdin); print(\"on\" if s.get(\"torRunning\") and (s.get(\"mode\") == \"socks\" or s.get(\"connected\")) else \"off\")' 2>/dev/null || echo off"
    ],
    "readMode": "eq",
    "readValue": "on",
    "onCommand": [
      "bash",
      "-c",
      "mode=$(tormarchy status --json 2>/dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin).get(\"mode\") or \"lan\")' 2>/dev/null); exec tormarchy connect \"${mode:-lan}\""
    ],
    "offCommand": [
      "tormarchy",
      "disconnect"
    ],
    "detail": "tripleu.tor",
    "sublabel": "Tor"
  }
