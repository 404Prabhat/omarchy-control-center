[
  {
    "id": "wifi",
    "slot": "wifi",
    "providerId": "omarchy.network",
    "title": "Wi-Fi",
    "glyph": "\uf1eb",
    "kind": "toggle",
    "backend": "command",
    "needsBin": "nmcli",
    "read": [
      "bash",
      "-c",
      "nmcli -t radio wifi | grep -q enabled && echo on || echo off"
    ],
    "readMode": "eq",
    "readValue": "on",
    "signalRead": [
      "bash",
      "-c",
      "nmcli -t -f IN-USE,SIGNAL dev wifi 2>/dev/null | grep '^\\*' | cut -d: -f2"
    ],
    "signalMode": "number",
    "onCommand": [
      "nmcli",
      "radio",
      "wifi",
      "on"
    ],
    "offCommand": [
      "nmcli",
      "radio",
      "wifi",
      "off"
    ],
    "detail": "omarchy.network"
  },
  {
    "id": "bluetooth",
    "slot": "bluetooth",
    "providerId": "omarchy.bluetooth",
    "title": "Bluetooth",
    "glyph": "\uf294",
    "kind": "toggle",
    "backend": "command",
    "needsBin": "bluetoothctl",
    "read": [
      "bash",
      "-c",
      "bluetoothctl show | grep -q 'Powered: yes' && echo on || echo off"
    ],
    "readMode": "eq",
    "readValue": "on",
    "signalRead": [
      "bash",
      "-c",
      "mac=$(bluetoothctl devices Connected 2>/dev/null | head -1 | awk '{print $2}'); [ -n \"$mac\" ] && bluetoothctl info \"$mac\" 2>/dev/null | grep 'RSSI:' | grep -o '\\-[0-9]*'"
    ],
    "signalMode": "rssi",
    "onCommand": [
      "omarchy-bluetooth-power",
      "on"
    ],
    "offCommand": [
      "omarchy-bluetooth-power",
      "off"
    ],
    "detail": "omarchy.bluetooth"
  },
